    "lsp",
    "mcp",
    "serena",
    "mcpls",
    "code-intelligence"
  ],
  "author": "Nathan Somers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pngdeity/opencode-codeintel.git"
  }
