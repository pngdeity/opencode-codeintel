{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pngdeity/opencode-codeintel",
  "version": "0.1.2",
  "description": "OpenCode V2 plugin for per-project socket-activated MCP code-intelligence routing and provisioning (Serena + mcpls fallback)",
  "keywords": [
    "code-intelligence",
    "lsp",
    "mcp",
    "mcpls",
    "opencode",
    "opencode-plugin",
    "serena"
  ],
  "license": "MIT",
  "author": "Nathan Somers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pngdeity/opencode-codeintel.git"
  },
  "bin": {
    "codeintel": "bin/codeintel.ts"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "bin/",
    "src/",
    "share/",
    "docs/",
    "!**/*.test.ts",
    "!**/*_test.py",
    "!**/__pycache__/",
    "!**/*.pyc",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./tui.tsx",
    "./core": "./src/codeintel/core.ts",
    "./descriptors": "./src/codeintel/descriptors.ts",
    "./snapshot": "./src/codeintel/snapshot.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
